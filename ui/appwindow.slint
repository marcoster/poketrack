import { Button, ComboBox, ProgressIndicator, ScrollView, ListView, Palette } from "std-widgets.slint";

// Poketrack GUI - main application window

export struct CardItem {
    dex_id: int,
    name: string,
    collected: bool,
}

export struct SetItem {
    set_id: string,
    name: string,
    language: string,
    release_date: string,
    missing_count: int,
}

// A small visual indicator for "is this card collected?" (non-interactive;
// taps are handled by the surrounding DragScrollBox).
component CollectBox inherits Rectangle {
    in property <bool> collected;
    border-radius: 6px;
    border-width: 2px;
    border-color: Palette.border;
    background: self.collected ? Palette.accent-background : Palette.control-background;
    Text {
        text: "✓";
        visible: root.collected;
        color: Palette.accent-foreground;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A manually-driven scroll viewport. The built-in ScrollView/ListView Flickable
// does not respond to raw touch drags on the Android backend, so we implement
// the drag ourselves with an explicit TouchArea and a content offset (y).
// Rows are NON-interactive visuals; taps are reported centrally via row-tapped
// (with the tapped x within the row), so the parent can decide the action
// without fighting the drag gesture.
component DragScrollBox inherits Rectangle {
    in property <length> row-height;
    in property <int> row-count;
    in property <length> row-spacing;
    // Where the (clipped) content currently sits. Negative moves it up so lower
    // rows become visible. The parent can read/reset this, e.g. on view switch.
    in-out property <length> offset-y;
    // Reports a tap on a row. x is the tapped position within the row (px from
    // the row's left edge), which the parent can use to hit-test action zones.
    callback row-tapped(row: int, x: length);

    clip: true;
    property <length> content-h: (self.row-count * self.row-height) + (self.row-count - 1) * self.row-spacing;
    property <length> max-scroll: max(0px, self.content-h - self.height);
    property <length> grab-pos: 0px;
    property <length> grab-offset: 0px;
    property <bool> dragging: false;

    VerticalLayout {
        width: parent.width;
        x: 0px;
        y: root.offset-y;
        spacing: root.row-spacing;
        @children
    }

    // The overlay that owns all pointer interaction for this viewport.
    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dragging = false;
                root.grab-pos = self.mouse-y;
                root.grab-offset = root.offset-y;
            } else if e.kind == PointerEventKind.up {
                if !root.dragging {
                    // It was a tap, not a drag. Hit-test the row.
                    let content-y = self.mouse-y - root.offset-y;
                    let row = content-y / root.row-height;
                    if row >= 0 && row < root.row-count {
                        root.row-tapped(row, self.mouse-x);
                    }
                }
                root.dragging = false;
            } else if e.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            let delta = self.mouse-y - root.grab-pos;
            if abs(delta) > 8 * 1px {
                root.dragging = true;
            }
            if root.dragging {
                root.offset-y = min(0px, max(-root.max-scroll, root.grab-offset + delta));
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Poketrack";
    width: 900px;
    height: 640px;

    in property <[CardItem]> cards-model;
    in property <[CardItem]> set-cards-model;
    in property <[SetItem]> sets-model;
    property <bool> show-cards-view: true;
    in property <string> selected-set-name: "";
    in property <string> status-text: "Ready";
    in property <float> progress: 0;
    in property <int> collected-count: 0;
    in property <int> total-count: 0;
    // Desktop-only; the DB update needs the cards-database-json/ data that is not
    // bundled on Android.
    in property <bool> show-update-button: true;
    // On narrow/mobile screens the top bar shows only the two view buttons.
    in property <bool> compact-top-bar: false;
    // True when the window is portrait-oriented (taller than wide). Drives the
    // responsive layout: the top bar collapses to just the view buttons and wide
    // set rows drop their extra columns so everything fits a phone held upright.
    property <bool> portrait: root.width < root.height;

    callback toggle-collected(dex_id: int);
    callback collect-set(set_id: string);
    callback update-database();
    callback select-set(set_id: string);
    callback clear-selected-set();
    callback set-filter(filter: string);
    callback set-sort(sort_by: string, direction: string);
    callback set-sets-sort(sort_by: string, direction: string);

    // Select the color scheme for the std-widgets (buttons, combo boxes, etc.).
    // Rewrite this line by hand to switch between a light or dark UI.
    //   ColorScheme.light -> dark UI (dark background, light text)
    //   ColorScheme.dark  -> light UI (light background, dark text)
    // The rest of the UI uses the Palette colors below, so it adapts automatically.
    public function set_theme() {
        Palette.color-scheme = ColorScheme.dark;
    }

    // ---- Top bar ----
    VerticalLayout {
        width: 100%;
        height: 100%;
        // Keep the top bar clear of the Android system status bar / notch.
        padding-top: root.safe-area-insets.top;
        Rectangle {
            height: 48px;
            width: 100%;
            background: Palette.control-background;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                if !root.portrait : Text {
                    text: "Poketrack";
                    font-size: 20px;
                    font-weight: 700;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }

                Button {
                    text: "Cards";
                    horizontal-stretch: root.portrait ? 1 : 0;
                    clicked => { root.show-cards-view = true; root.clear-selected-set(); }
                }
                Button {
                    text: "Sets";
                    horizontal-stretch: root.portrait ? 1 : 0;
                    clicked => { root.show-cards-view = false; root.clear-selected-set(); }
                }

                if !root.portrait : ProgressIndicator {
                    width: 160px;
                    progress: root.progress;
                }

                if !root.portrait : Text {
                    text: root.status-text;
                    color: Palette.foreground;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                if root.show-update-button : Button {
                    text: "Update Database";
                    clicked => { root.update-database(); }
                }
            }
        }

        // ---- Content ----
        // ---- Main panel ----
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Palette.control-background;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 12px;
                spacing: 8px;

                // Cards view
                if root.show-cards-view : VerticalLayout {
                    width: 100%;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        ComboBox {
                            width: 130px;
                            model: ["All", "Collected", "Missing"];
                            selected(value) => {
                                if value == "All" { root.set-filter("all"); }
                                else if value == "Collected" { root.set-filter("collected"); }
                                else if value == "Missing" { root.set-filter("missing"); }
                            }
                        }
                        ComboBox {
                            width: 130px;
                            model: ["Number", "Name"];
                            selected(value) => {
                                if value == "Name" { root.set-sort("name", "asc"); }
                                else { root.set-sort("number", "asc"); }
                            }
                        }
                    }

                    cards-list := DragScrollBox {
                        width: 100%;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        row-height: 30px;
                        row-count: root.cards-model.length;
                        row-spacing: 2px;
                        row-tapped(row, x) => {
                            root.toggle-collected(root.cards-model[row].dex_id);
                        }
                        for card in root.cards-model : HorizontalLayout {
                            height: 30px;
                            width: 100%;
                            spacing: 8px;
                            padding: 4px;
                            CollectBox { collected: card.collected; }
                            Text {
                                text: "#" + card.dex_id;
                                font-size: 14px;
                                color: Palette.foreground;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: card.name;
                                font-size: 14px;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.collected-count + " of " + root.total-count + " cards (" + (root.total-count - root.collected-count) + " missing)";
                        font-size: 12px;
                        color: gray;
                    }
                }

                // Sets view
                if !root.show-cards-view && root.selected-set-name == "" : VerticalLayout {
                    width: 100%;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        ComboBox {
                            width: 130px;
                            model: ["Language", "Set id", "Missing"];
                            selected(value) => {
                                if value == "Set id" { root.set-sets-sort("id", "asc"); }
                                else if value == "Missing" { root.set-sets-sort("missing", "asc"); }
                                else { root.set-sets-sort("language", "asc"); }
                            }
                        }
                    }
                    DragScrollBox {
                        width: 100%;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        row-height: 30px;
                        row-count: root.sets-model.length;
                        row-spacing: 2px;
                        row-tapped(row, x) => {
                            // Left strip = Details, right strip = Add missing, middle = details too.
                            if x < 90px {
                                root.select-set(root.sets-model[row].set_id);
                            } else if x > self.width - 110px && root.sets-model[row].missing_count > 0 {
                                root.collect-set(root.sets-model[row].set_id);
                            } else {
                                root.select-set(root.sets-model[row].set_id);
                            }
                        }
                        for set in root.sets-model : HorizontalLayout {
                            height: 30px;
                            width: 100%;
                            spacing: 4px;
                            padding: 4px;
                            Rectangle {
                                width: 86px;
                                border-radius: 6px;
                                background: Palette.accent-background;
                                Text {
                                    text: "Details";
                                    color: Palette.accent-foreground;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: set.name;
                                font-size: 14px;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if !root.portrait : Text {
                                text: set.set_id;
                                font-size: 12px;
                                color: gray;
                                width: 90px;
                                vertical-alignment: center;
                            }
                            if !root.portrait : Text {
                                text: set.language;
                                font-size: 12px;
                                color: gray;
                                width: 70px;
                                vertical-alignment: center;
                            }
                            if !root.portrait : Text {
                                text: set.release_date;
                                font-size: 12px;
                                color: gray;
                                width: 80px;
                                vertical-alignment: center;
                            }
                            if !root.portrait : Text {
                                text: set.missing_count + " missing";
                                font-size: 12px;
                                width: 80px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 106px;
                                border-radius: 6px;
                                background: set.missing_count > 0 ? Palette.accent-background : Palette.control-background;
                                Text {
                                    text: "Add missing";
                                    color: Palette.accent-foreground;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: "Showing " + root.sets-model.length + " sets";
                        font-size: 12px;
                        color: gray;
                    }
                }

                // Set details view
                if !root.show-cards-view && root.selected-set-name != "" : VerticalLayout {
                    width: 100%;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        Button {
                            text: "<- Back";
                            clicked => { root.clear-selected-set(); }
                        }
                        Text {
                            text: root.selected-set-name;
                            font-size: 18px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }
                    }
                    DragScrollBox {
                        width: 100%;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        row-height: 30px;
                        row-count: root.set-cards-model.length;
                        row-spacing: 2px;
                        row-tapped(row, x) => {
                            root.toggle-collected(root.set-cards-model[row].dex_id);
                        }
                        for card in root.set-cards-model : HorizontalLayout {
                            height: 30px;
                            width: 100%;
                            spacing: 8px;
                            padding: 4px;
                            CollectBox { collected: card.collected; }
                            Text {
                                text: "#" + card.dex_id;
                                font-size: 14px;
                                color: Palette.foreground;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: card.name;
                                font-size: 14px;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
