import { Button, CheckBox, ComboBox, ProgressIndicator, ScrollView, ListView, Palette } from "std-widgets.slint";

// Poketrack GUI - main application window

export struct CardItem {
    dex_id: int,
    name: string,
    collected: bool,
}

export struct SetItem {
    set_id: string,
    name: string,
    language: string,
    release_date: string,
    missing_count: int,
}

export component AppWindow inherits Window {
    title: "Poketrack";
    width: 900px;
    height: 640px;

    in property <[CardItem]> cards-model;
    in property <[CardItem]> set-cards-model;
    in property <[SetItem]> sets-model;
    property <bool> show-cards-view: true;
    in property <string> selected-set-name: "";
    in property <string> status-text: "Ready";
    in property <float> progress: 0;
    in property <int> collected-count: 0;
    in property <int> total-count: 0;
    // Injected from Rust on resize so the list fills the window height
    // (Slint's root.height stays stale under Wayland/winit here).
    in property <length> fill-height: 600px;

    callback toggle-collected(dex_id: int);
    callback collect-set(set_id: string);
    callback update-database();
    callback select-set(set_id: string);
    callback clear-selected-set();
    callback set-filter(filter: string);
    callback set-sort(sort_by: string, direction: string);
    callback set-sets-sort(sort_by: string, direction: string);

    // Select the color scheme for the std-widgets (buttons, combo boxes, etc.).
    // Rewrite this line by hand to switch between a light or dark UI.
    //   ColorScheme.light -> dark UI (dark background, light text)
    //   ColorScheme.dark  -> light UI (light background, dark text)
    // The rest of the UI uses the Palette colors below, so it adapts automatically.
    public function set_theme() {
        Palette.color-scheme = ColorScheme.dark;
    }

    // ---- Top bar ----
    VerticalLayout {
        width: 100%;
        height: 100%;
        Rectangle {
            height: 48px;
            width: 100%;
            background: Palette.control-background;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                Text {
                    text: "Poketrack";
                    font-size: 20px;
                    font-weight: 700;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }

                Button {
                    text: "Cards";
                    clicked => { root.show-cards-view = true; root.clear-selected-set(); }
                }
                Button {
                    text: "Sets";
                    clicked => { root.show-cards-view = false; root.clear-selected-set(); }
                }

                ProgressIndicator {
                    width: 160px;
                    progress: root.progress;
                }

                Text {
                    text: root.status-text;
                    color: Palette.foreground;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Update Database";
                    clicked => { root.update-database(); }
                }
            }
        }

        // ---- Content ----
        // ---- Main panel ----
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            height: max(root.fill-height - 48px, 200px);
            background: Palette.control-background;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 12px;
                spacing: 8px;

                // Cards view
                if root.show-cards-view : VerticalLayout {
                    width: 100%;
                    height: 100%;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        ComboBox {
                            width: 130px;
                            model: ["All", "Collected", "Missing"];
                            selected(value) => {
                                if value == "All" { root.set-filter("all"); }
                                else if value == "Collected" { root.set-filter("collected"); }
                                else if value == "Missing" { root.set-filter("missing"); }
                            }
                        }
                        ComboBox {
                            width: 130px;
                            model: ["Number", "Name"];
                            selected(value) => {
                                if value == "Name" { root.set-sort("name", "asc"); }
                                else { root.set-sort("number", "asc"); }
                            }
                        }
                    }

                        ListView {
                            width: 100%;
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            for card in root.cards-model : HorizontalLayout {
                                width: 100%;
                                spacing: 8px;
                                padding: 4px;

                                CheckBox {
                                    checked: card.collected;
                                    toggled => {
                                        root.toggle-collected(card.dex_id);
                                    }
                                }

                                Text {
                                    text: "#" + card.dex_id;
                                    font-size: 14px;
                                    color: Palette.foreground;
                                    width: 56px;
                                }

                                Text {
                                    text: card.name;
                                    font-size: 14px;
                                    color: Palette.foreground;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                    Text {
                        text: root.collected-count + " of " + root.total-count + " cards (" + (root.total-count - root.collected-count) + " missing)";
                        font-size: 12px;
                        color: gray;
                    }
                }

                // Sets view
                if !root.show-cards-view && root.selected-set-name == "" : VerticalLayout {
                    width: 100%;
                    height: 100%;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        ComboBox {
                            width: 130px;
                            model: ["Language", "Set id", "Missing"];
                            selected(value) => {
                                if value == "Set id" { root.set-sets-sort("id", "asc"); }
                                else if value == "Missing" { root.set-sets-sort("missing", "asc"); }
                                else { root.set-sets-sort("language", "asc"); }
                            }
                        }
                    }
                        ListView {
                            width: 100%;
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            for set in root.sets-model : HorizontalLayout {
                                width: 100%;
                                spacing: 8px;
                                padding: 4px;

                                Button {
                                    text: "Details";
                                    clicked => { root.select-set(set.set_id); }
                                }

                                Text {
                                    text: set.name;
                                    font-size: 14px;
                                    color: Palette.foreground;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: set.set_id;
                                    font-size: 12px;
                                    color: gray;
                                    width: 90px;
                                }

                                Text {
                                    text: set.language;
                                    font-size: 12px;
                                    color: gray;
                                    width: 70px;
                                }

                                Text {
                                    text: set.release_date;
                                    font-size: 12px;
                                    color: gray;
                                    width: 80px;
                                }

                                Text {
                                    text: set.missing_count + " missing";
                                    font-size: 12px;
                                    width: 80px;
                                }

                                Button {
                                    text: "Add missing";
                                    enabled: set.missing_count > 0;
                                    clicked => { root.collect-set(set.set_id); }
                                }
                            }
                        }
                    Text {
                        text: "Showing " + root.sets-model.length + " sets";
                        font-size: 12px;
                        color: gray;
                    }
                }

                // Set details view
                if !root.show-cards-view && root.selected-set-name != "" : VerticalLayout {
                    width: 100%;
                    height: 100%;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        Button {
                            text: "<- Back";
                            clicked => { root.clear-selected-set(); }
                        }
                        Text {
                            text: root.selected-set-name;
                            font-size: 18px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }
                    }
                        ListView {
                            width: 100%;
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            for card in root.set-cards-model : HorizontalLayout {
                                width: 100%;
                                spacing: 8px;
                                padding: 4px;

                                CheckBox {
                                    checked: card.collected;
                                    toggled => {
                                        root.toggle-collected(card.dex_id);
                                    }
                                }

                                Text {
                                    text: "#" + card.dex_id;
                                    font-size: 14px;
                                    color: Palette.foreground;
                                    width: 56px;
                                }

                                Text {
                                    text: card.name;
                                    font-size: 14px;
                                    color: Palette.foreground;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                }
            }
        }
    }
}
